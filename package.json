{
  "name": "legion-bobiverse",
  "version": "0.1.0",
  "type": "module",
  "description": "Bobiverse: Replication Protocol — Production game prototype",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "accept:legion": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/legion-accept.mjs",
    "accept:continuum": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/continuum-accept.mjs",
    "accept:continuum:stills": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/continuum-accept.mjs --only stills",
    "accept:continuum:perf": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/continuum-accept.mjs --only perf",
    "accept:continuum:motion": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/continuum-accept.mjs --only motion",
    "accept:continuum:qa": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/continuum-accept.mjs --only stills,perf,motion",
    "accept:demos": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/legion-accept.mjs --demo star,blackhole,nebula,galaxy --only stills --skip-qa",
    "accept:archetypes": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/continuum-accept.mjs --type all --only stills --skip-qa"
  },
  "dependencies": {
    "bitecs": "^0.3.40",
    "colyseus.js": "^0.16.22",
    "dexie": "^4.0.10",
    "fflate": "^0.8.2",
    "howler": "^2.2.4",
    "mistreevous": "^4.3.1",
    "ngraph.graph": "^20.0.1",
    "ngraph.path": "^1.5.0",
    "three": "^0.171.0",
    "tone": "^15.4.3",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "playwright": "^1.62.1",
    "stats-gl": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.8"
  }
}
